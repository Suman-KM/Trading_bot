# Virtual environment
.venv/
env/
venv/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS artifacts
.DS_Store
Thumbs.db

# IDE and editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Build and packaging artifacts
build/
dist/
*.egg-info/
*.egg

# Logs
*.log
logs/

# Local market data (preserve folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Model artifacts and serialized weights
*.pkl
*.joblib
*.onnx
models/saved/*
!models/saved/.gitkeep
